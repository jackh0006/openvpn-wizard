client
dev tun
proto tcp-client
remote {{ server_ip }} 443
nobind
persist-key
persist-tun
remote-cert-tls server
cipher AES-256-GCM
auth SHA384
tls-version-min 1.3
tls-ciphersuites TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
auth-user-pass
verb 3
mute 20
sndbuf 0
rcvbuf 0

<ca>
{{ ca_crt }}
</ca>

<cert>
{{ client_crt }}
</cert>

<key>
{{ client_key }}
</key>

<tls-crypt>
{{ ta_key }}
</tls-crypt>